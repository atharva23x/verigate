# Copy to .env (or set in your shell) to override defaults.
MOCK_MODE=True
SEED_ON_STARTUP=True
VERIGATE_DB=verigate.db
VERIGATE_STORAGE=storage
JWT_SECRET=verigate-demo-secret-change-in-prod
JWT_EXPIRES_MIN=480
OCR_CONFIDENCE_THRESHOLD=0.90
# Optional: portals to simulate as globally down. Leave empty for the seeded
# demo - scenario D pins its outage to a single record instead.
ISSUER_OUTAGE_PORTALS=
