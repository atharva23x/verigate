  "global_rules": [
    {
      "rule_id": "APH-GEN-F01",
      "check": "issue_date_not_future",
      "severity": "CRITICAL",
      "reason": "Issue date is in the future - document cannot be relied upon."
    },
    {
      "rule_id": "APH-GEN-F02",
      "check": "expiry_not_past",
      "severity": "CRITICAL",
      "reason": "Document has expired - a valid, un-expired document is required."
    },
    {
      "rule_id": "APH-GEN-F03",
      "check": "required_fields_present",
      "severity": "WARN",
      "reason": "One or more mandatory fields could not be extracted from the document."
    },
    {
      "rule_id": "APH-GEN-T01",
      "check": "tamper_score",
      "severity": "CRITICAL",
      "reason": "Error Level Analysis indicates a region with anomalous recompression (possible edit)."
    },
    {
      "rule_id": "APH-GEN-D01",
      "check": "duplicate_phash",
      "severity": "CRITICAL",
      "reason": "Perceptual hash matches a document already submitted by another application."
    },
    {
      "rule_id": "APH-GEN-I01",
      "check": "issuer_verified",
      "severity": "CRITICAL",
      "reason": "Issuer portal could not confirm this document (INVALID / NOT_FOUND / EXPIRED / SOURCE_UNAVAILABLE)."
    },
    {
      "rule_id": "APH-GEN-C01",
      "check": "consistency_score",
      "severity": "WARN",
      "reason": "Extracted fields are inconsistent with the AICTE master record."
    },
    {
      "rule_id": "APH-GEN-O01",
      "check": "ocr_confidence",
      "severity": "WARN",
      "reason": "OCR confidence below the Evidence Gate threshold - machine cannot vouch for the text."
    }
  ]
}
